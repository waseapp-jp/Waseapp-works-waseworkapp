rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'aimutsu0120@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read, write: if true;
    }
    match /{path=**}/users/{userId} {
      allow read, write: if true;
    }

    // --- Users Secrets Collection ---
    match /users_secrets/{userId} {
      allow read, write: if true;
    }
    match /{path=**}/users_secrets/{userId} {
      allow read, write: if true;
    }

    // --- Tasks Collection (Root & Subcollections & CollectionGroup) ---
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /{path=**}/tasks/{taskId} {
      allow read, write: if true;
    }

    // --- Messages Collection (Root & Subcollections & CollectionGroup) ---
    match /messages/{messageId} {
      allow read, write: if true;
    }
    match /{path=**}/messages/{messageId} {
      allow read, write: if true;
    }

    // --- Files Collection (Root & Subcollections & CollectionGroup) ---
    match /files/{fileId} {
      allow read, write: if true;
    }
    match /{path=**}/files/{fileId} {
      allow read, write: if true;
    }

    // --- Meetings Collection (Root & Subcollections & CollectionGroup) ---
    match /meetings/{meetingId} {
      allow read, write: if true;
    }
    match /{path=**}/meetings/{meetingId} {
      allow read, write: if true;
    }

    // --- Audit Logs Collection (Root & Subcollections & CollectionGroup) ---
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
    match /{path=**}/auditLogs/{logId} {
      allow read, write: if true;
    }

    // --- Channels Collection (Root & Subcollections & CollectionGroup) ---
    match /channels/{channelId} {
      allow read, write: if true;
    }
    match /{path=**}/channels/{channelId} {
      allow read, write: if true;
    }

    // --- Tenants Collection ---
    match /tenants/{tenantId} {
      allow read, write: if true;
    }
    match /{path=**}/tenants/{tenantId} {
      allow read, write: if true;
    }

    // --- P2P Signaling & Room Presence ---
    match /p2p_signals/{signalId} {
      allow read, write: if true;
    }
    match /{path=**}/p2p_signals/{signalId} {
      allow read, write: if true;
    }

    match /p2p_rooms/{roomId}/peers/{peerId} {
      allow read, write: if true;
    }
    match /{path=**}/peers/{peerId} {
      allow read, write: if true;
    }

    // --- Health Check / Test documents ---
    match /test/{docId} {
      allow read, write: if true;
    }
    match /{path=**}/test/{docId} {
      allow read, write: if true;
    }
  }
}
